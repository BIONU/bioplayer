<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="10dp" android:background="#1A1A1A">

    <ImageView android:id="@+id/groupLogo" android:layout_width="70dp" android:layout_height="70dp" android:layout_marginEnd="18dp" android:contentDescription="@null" />

    <TextView android:id="@+id/groupTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF" android:singleLine="true" android:maxLines="1" android:ellipsize="end" />

</LinearLayout>
