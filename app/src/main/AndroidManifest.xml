<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Don't require a touchscreen or D-pad specifically - support both phone and TV -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:label="BIOplayer" android:banner="@drawable/tv_banner" android:theme="@style/Theme.BIOplayer" android:supportsRtl="true" android:networkSecurityConfig="@xml/network_security_config">

        <activity android:name=".ui.MainActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Makes the app show up on the Android TV home screen launcher too -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.GroupBrowserActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity android:name=".ui.PlayerActivity" android:exported="false" android:theme="@style/Theme.BIOplayer.Player" android:configChanges="orientation|screenSize|keyboardHidden" />

    </application>
</manifest>
